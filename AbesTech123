        <textarea id="msg" placeholder="How can we help?" required></textarea>
        <button class="btn btn-primary" type="submit">Send via WhatsApp</button>
      </form>
    </div>
  </div>
</section>

<footer>
  <div class="container">© <span id="yr"></span> AbeTech123. Building Skills. Solving Technology Problems. Creating the Future.</div>
</footer>

<a class="wa-float" href="https://wa.me/200000000000" target="_blank" rel="noopener" aria-label="WhatsApp">💬</a>

<div class="modal" id="modal">
  <div class="modal-box">
    <button class="close" id="mclose" aria-label="Close">✕</button>
    <div id="mcontent"></div>
  </div>
</div>

<script>
// Set your WhatsApp number (digits only, with country code)
const WHATSAPP = "200000000000";

// Mobile menu
const menu = document.getElementById('menu');
document.getElementById('burger').onclick = () => menu.classList.toggle('open');
menu.querySelectorAll('a').forEach(a => a.onclick = () => menu.classList.remove('open'));

// Active nav link
const links = [...menu.querySelectorAll('a')];
const secs = links.map(a => document.querySelector(a.getAttribute('href')));
addEventListener('scroll', () => {
  const y = scrollY + 120;
  secs.forEach((s, i) => links[i].classList.toggle('active', s.offsetTop <= y && s.offsetTop + s.offsetHeight > y));
}, {passive:true});

// Scroll reveal
const io = new IntersectionObserver(es => es.forEach(e => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }), {threshold:.12});
document.querySelectorAll('.reveal').forEach(el => io.observe(el));

// Typing effect
const code = `<span class="k">const</span> abetech = {
  <span class="f">name</span>: <span class="s">"AbeTech123"</span>,
  <span class="f">teaches</span>: [<span class="s">"HTML"</span>, <span class="s">"CSS"</span>, <span class="s">"JS"</span>, <span class="s">"Python"</span>],
  <span class="f">fixes</span>:   [<span class="s">"Computers"</span>, <span class="s">"Phones"</span>],
  <span class="f">builds</span>:  <span class="s">"the future"</span>
};

<span class="c">// Let's build something.</span>
<span class="f">start</span>(abetech);`;
const out = document.getElementById('typed');
let i = 0, inTag = false, buf = '';
(function type(){
  if (matchMedia('(prefers-reduced-motion: reduce)').matches) { out.innerHTML = code; return; }
  if (i < code.length) {
    const ch = code[i++];
    buf += ch;
    if (ch === '<') inTag = true;
    if (ch === '>') inTag = false;
    out.innerHTML = buf + '<span class="cursor"></span>';
    setTimeout(type, inTag ? 0 : 22);
  } else { out.innerHTML = buf + '<span class="cursor"></span>'; }
})();

// Gallery filter
const shots = [...document.querySelectorAll('.shot')];
document.getElementById('filters').addEventListener('click', e => {
  const b = e.target.closest('button'); if (!b) return;
  document.querySelectorAll('#filters button').forEach(x => x.classList.remove('on'));
  b.classList.add('on');
  shots.forEach(s => s.classList.toggle('hide', b.dataset.f !== 'all' && s.dataset.c !== b.dataset.f));
});

// Modal (gallery + videos)
const modal = document.getElementById('modal'), mc = document.getElementById('mcontent');
const open = html => { mc.innerHTML = html; modal.classList.add('open'); };
const close = () => { modal.classList.remove('open'); mc.innerHTML = ''; };
document.getElementById('mclose').onclick = close;
modal.onclick = e => { if (e.target === modal) close(); };
addEventListener('keydown', e => { if (e.key === 'Escape') close(); });

shots.forEach(s => s.onclick = () => {
  const img = s.querySelector('img');
  open(img ? `<img src="${img.src}" alt="${img.alt}" style="border-radius:10px">`
           : `<div class="empty"><div><div style="font-size:3rem">${s.firstChild.textContent}</div><p>${s.querySelector('span').textContent}<br>Add your photo here.</p></div></div>`);
});
document.querySelectorAll('.video').forEach(v => v.onclick = () => {
  const id = v.dataset.yt.trim();
  open(id ? `<iframe src="https://www.youtube.com/embed/${encodeURIComponent(id)}?autoplay=1" allow="autoplay; encrypted-media; fullscreen" allowfullscreen></iframe>`
          : `<div class="empty"><p>Video coming soon.<br>Add a YouTube ID in the <b>data-yt</b> attribute of this card.</p></div>`);
});

// Contact form -> WhatsApp
document.getElementById('form').onsubmit = e => {
  e.preventDefault();
  const t = `Hello AbeTech123, I'm ${name.value}.\nTopic: ${topic.value}\n${msg.value}`;
  window.open(`https://wa.me/${WHATSAPP}?text=${encodeURIComponent(t)}`, '_blank');
};

document.getElementById('yr').textContent = new Date().getFullYear();
</script>
</body>
</html>
