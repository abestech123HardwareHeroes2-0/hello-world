<style>
:root{
  --bg:#0b0f1a; --bg2:#111827; --card:#151c2e; --line:#243049;
  --text:#e8edf7; --muted:#97a3bd; --accent:#22d3ee; --accent2:#8b5cf6; --ok:#25d366;
  --radius:16px;
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{font-family:Inter,system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;background:var(--bg);color:var(--text);line-height:1.6;overflow-x:hidden}
a{color:inherit;text-decoration:none}
img{max-width:100%;display:block}
.container{width:min(1140px,92%);margin-inline:auto}
section{padding:90px 0}
.section-head{text-align:center;max-width:680px;margin:0 auto 48px}
.eyebrow{color:var(--accent);font-weight:700;letter-spacing:.14em;font-size:.8rem;text-transform:uppercase}
h2{font-size:clamp(1.8rem,4vw,2.6rem);margin:8px 0 12px;line-height:1.2}
.section-head p{color:var(--muted)}
.grad{background:linear-gradient(90deg,var(--accent),var(--accent2));-webkit-background-clip:text;background-clip:text;color:transparent}

/* Nav */
header{position:fixed;inset:0 0 auto 0;z-index:50;background:rgba(11,15,26,.8);backdrop-filter:blur(12px);border-bottom:1px solid var(--line)}
.nav{display:flex;align-items:center;justify-content:space-between;height:68px}
.logo{font-weight:800;font-size:1.35rem;letter-spacing:-.02em}
.logo span{color:var(--accent)}
nav ul{display:flex;gap:22px;list-style:none}
nav a{color:var(--muted);font-size:.93rem;font-weight:500;transition:.2s}
nav a:hover,nav a.active{color:var(--accent)}
.burger{display:none;background:none;border:0;color:var(--text);font-size:1.6rem;cursor:pointer}

/* Buttons */
.btn{display:inline-flex;align-items:center;gap:8px;padding:13px 26px;border-radius:999px;font-weight:600;border:1px solid transparent;cursor:pointer;transition:.25s;font-size:1rem}
.btn-primary{background:linear-gradient(90deg,var(--accent),var(--accent2));color:#06101c}
.btn-primary:hover{transform:translateY(-2px);box-shadow:0 10px 30px rgba(34,211,238,.25)}
.btn-ghost{border-color:var(--line);color:var(--text);background:transparent}
.btn-ghost:hover{border-color:var(--accent);color:var(--accent)}

/* Hero */
.hero{min-height:100vh;display:flex;align-items:center;padding-top:110px;position:relative;
  background:radial-gradient(800px 400px at 80% 10%,rgba(139,92,246,.22),transparent),
             radial-gradient(700px 400px at 10% 90%,rgba(34,211,238,.16),transparent),var(--bg)}
.hero-grid{display:grid;grid-template-columns:1.1fr .9fr;gap:48px;align-items:center}
.tag{display:inline-block;border:1px solid var(--line);background:var(--bg2);padding:6px 14px;border-radius:999px;font-size:.85rem;color:var(--muted);margin-bottom:20px}
.hero h1{font-size:clamp(2.6rem,7vw,4.6rem);line-height:1.05;letter-spacing:-.03em}
.hero h2.sub{font-size:clamp(1.1rem,2.4vw,1.5rem);font-weight:600;margin:16px 0;color:var(--text)}
.hero p{color:var(--muted);max-width:540px;margin-bottom:30px}
.cta{display:flex;flex-wrap:wrap;gap:14px}
.code-card{background:#0a1020;border:1px solid var(--line);border-radius:var(--radius);box-shadow:0 30px 80px rgba(0,0,0,.5);overflow:hidden;animation:float 6s ease-in-out infinite}
.code-top{display:flex;gap:7px;padding:12px 16px;background:var(--bg2);border-bottom:1px solid var(--line)}
.code-top i{width:12px;height:12px;border-radius:50%;background:#ff5f57}
.code-top i:nth-child(2){background:#febc2e}.code-top i:nth-child(3){background:#28c840}
.code-card pre{padding:22px;font-family:"Fira Code",Consolas,monospace;font-size:.88rem;color:#c9d6f2;overflow-x:auto;min-height:230px}
.k{color:#c792ea}.s{color:#a5e075}.f{color:#5ccfe6}.c{color:#5c6a8a}
.cursor{display:inline-block;width:8px;height:1em;background:var(--accent);vertical-align:-2px;animation:blink 1s steps(2) infinite}
@keyframes blink{50%{opacity:0}}
@keyframes float{50%{transform:translateY(-10px)}}

/* Cards */
.grid{display:grid;gap:22px}
.g3{grid-template-columns:repeat(3,1fr)}
.g4{grid-template-columns:repeat(4,1fr)}
.card{background:var(--card);border:1px solid var(--line);border-radius:var(--radius);padding:28px;transition:.3s}
.card:hover{transform:translateY(-6px);border-color:var(--accent);box-shadow:0 18px 40px rgba(0,0,0,.35)}
.icon{font-size:2rem;margin-bottom:14px}
.card h3{font-size:1.15rem;margin-bottom:8px}
.card p{color:var(--muted);font-size:.95rem}
.alt{background:var(--bg2)}
.list{list-style:none;margin-top:14px}
.list li{color:var(--muted);font-size:.93rem;padding:5px 0 5px 22px;position:relative}
.list li::before{content:"▹";position:absolute;left:0;color:var(--accent)}

/* About */
.about{display:grid;grid-template-columns:1fr 1fr;gap:48px;align-items:center}
.about p{color:var(--muted);margin-bottom:16px}
.stats{display:grid;grid-template-columns:repeat(2,1fr);gap:16px}
.stat{background:var(--card);border:1px solid var(--line);border-radius:var(--radius);padding:24px;text-align:center}
.stat b{display:block;font-size:2rem}

/* Gallery */
.filters{display:flex;flex-wrap:wrap;gap:10px;justify-content:center;margin-bottom:30px}
.filters button{background:var(--card);border:1px solid var(--line);color:var(--muted);padding:8px 18px;border-radius:999px;cursor:pointer;font-size:.9rem;transition:.2s}
.filters button.on,.filters button:hover{border-color:var(--accent);color:var(--accent)}
.gallery{display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:16px}
.shot{aspect-ratio:4/3;border-radius:14px;border:1px solid var(--line);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;cursor:pointer;position:relative;overflow:hidden;transition:.3s;font-size:2.4rem}
.shot span{font-size:.85rem;color:rgba(255,255,255,.85);font-weight:600}
.shot:hover{transform:scale(1.03);border-color:var(--accent)}
.shot img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
.shot.hide{display:none}
.g-code{background:linear-gradient(135deg,#1e3a8a,#0e7490)}
.g-pc{background:linear-gradient(135deg,#4c1d95,#1d4ed8)}
.g-phone{background:linear-gradient(135deg,#9d174d,#6d28d9)}
.g-repair{background:linear-gradient(135deg,#9a3412,#be185d)}
.g-proj{background:linear-gradient(135deg,#065f46,#0e7490)}
.note{text-align:center;color:var(--muted);font-size:.85rem;margin-top:22px}

/* Videos */
.video{background:var(--card);border:1px solid var(--line);border-radius:var(--radius);overflow:hidden;transition:.3s;cursor:pointer}
.video:hover{transform:translateY(-6px);border-color:var(--accent)}
.thumb{aspect-ratio:16/9;display:grid;place-items:center;background:linear-gradient(135deg,#111a33,#1e1b4b);position:relative}
.play{width:62px;height:62px;border-radius:50%;background:linear-gradient(90deg,var(--accent),var(--accent2));display:grid;place-items:center;color:#06101c;font-size:1.4rem;padding-left:4px;transition:.25s}
.video:hover .play{transform:scale(1.12)}
.video .meta{padding:18px 20px}
.video h3{font-size:1.05rem;margin-bottom:4px}
.video p{color:var(--muted);font-size:.9rem}
.modal{position:fixed;inset:0;background:rgba(3,6,12,.88);display:none;align-items:center;justify-content:center;z-index:100;padding:20px}
.modal.open{display:flex}
.modal-box{width:min(900px,100%);background:var(--bg2);border:1px solid var(--line);border-radius:var(--radius);padding:18px;position:relative}
.modal-box iframe{width:100%;aspect-ratio:16/9;border:0;border-radius:10px}
.modal-box .empty{aspect-ratio:16/9;display:grid;place-items:center;text-align:center;color:var(--muted);padding:20px}
.close{position:absolute;top:-14px;right:-14px;width:36px;height:36px;border-radius:50%;border:0;background:var(--accent);color:#06101c;font-size:1.1rem;font-weight:700;cursor:pointer}

/* Contact */
.contact{display:grid;grid-template-columns:1fr 1fr;gap:36px}
.c-links{display:grid;gap:14px;align-content:start}
.c-link{display:flex;align-items:center;gap:16px;background:var(--card);border:1px solid var(--line);border-radius:var(--radius);padding:18px 22px;transition:.25s}
.c-link:hover{border-color:var(--accent);transform:translateX(6px)}
.c-link .ico{font-size:1.6rem}
.c-link small{display:block;color:var(--muted)}
.wa{background:var(--ok);color:#052e16;font-weight:700;border-color:var(--ok)}
form{background:var(--card);border:1px solid var(--line);border-radius:var(--radius);padding:28px;display:grid;gap:14px}
input,textarea,select{width:100%;background:var(--bg);border:1px solid var(--line);color:var(--text);padding:13px 16px;border-radius:10px;font:inherit}
input:focus,textarea:focus,select:focus{outline:none;border-color:var(--accent)}
textarea{min-height:120px;resize:vertical}

footer{border-top:1px solid var(--line);padding:30px 0;text-align:center;color:var(--muted);font-size:.9rem}
.wa-float{position:fixed;right:20px;bottom:20px;z-index:60;width:58px;height:58px;border-radius:50%;background:var(--ok);display:grid;place-items:center;font-size:1.7rem;box-shadow:0 10px 30px rgba(0,0,0,.4);transition:.25s}
.wa-float:hover{transform:scale(1.1)}

/* Reveal */
.reveal{opacity:0;transform:translateY(28px);transition:opacity .7s,transform .7s}
.reveal.in{opacity:1;transform:none}

@media(max-width:900px){
  .hero-grid,.about,.contact{grid-template-columns:1fr}
  .g3,.g4{grid-template-columns:repeat(2,1fr)}
  .burger{display:block}
  nav{position:absolute;top:68px;left:0;right:0;background:var(--bg2);border-bottom:1px solid var(--line);display:none}
  nav.open{display:block}
  nav ul{flex-direction:column;gap:0;padding:10px 4%}
  nav li a{display:block;padding:12px 0}
}
@media(max-width:560px){
  section{padding:70px 0}
  .g3,.g4{grid-template-columns:1fr}
}
@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}.reveal{opacity:1;transform:none}}
</style>
</head>
